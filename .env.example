# Variabili e segreti (PRD sezione 9.8). Solo nomi, nessun valore reale.
# In locale i valori vanno in .dev.vars (Wrangler) o .env.local (next dev): entrambi esclusi da git.
# In staging e produzione: secret di Cloudflare e di GitHub.

# --- Pubbliche (finiscono nel browser) ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Chiave pubblicabile di Supabase, MAI quella segreta
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Dominio delle immagini su R2
NEXT_PUBLIC_IMAGES_BASE_URL=
# Usate solo con il consenso ai cookie
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Segreti (solo server) ---
# Solo nei file che importano "server-only"
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Chiave limitata del conto Stripe dell'azienda; in staging e in locale chiave di test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRON_SECRET=

# --- Variabili (solo server, non segrete) ---
AI_SUMMARY_MODEL=
SENTRY_DSN=
INDEXNOW_KEY=

# Binding Cloudflare (in wrangler.jsonc, non qui): PHOTOS (R2), AI (Workers AI), RATE_LIMITER
