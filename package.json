{
  "name": "veloci-private",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "npm run cf-typegen && next typegen && tsc --noEmit",
    "lint": "eslint && npm run check:logical-css",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:staging": "opennextjs-cloudflare build --env staging && opennextjs-cloudflare deploy --env staging",
    "deploy:production": "opennextjs-cloudflare build --env production && opennextjs-cloudflare deploy --env production",
    "check:worker-size": "node scripts/check-worker-size.mjs",
    "check:logical-css": "node scripts/check-logical-css.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-main-module=false cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@sentry/nextjs": "11.12.0",
    "libphonenumber-js": "1.13.16",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  }
}
